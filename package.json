{
  "name": "codictate",
  "version": "0.0.9",
  "description": "Local, private voice dictation for macOS and Windows.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EmilLykke/codictate.git"
  },
  "homepage": "https://github.com/EmilLykke/codictate",
  "bugs": {
    "url": "https://github.com/EmilLykke/codictate/issues"
  },
  "scripts": {
    "test": "bun test",
    "test:manual": "bun test ./src/bun/utils/whisper/model-download-reachability.manual.ts ./benchmarks/stt/results-archive.manual.ts ./benchmarks/contract/fleurs-identity.manual.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "tsc": "tsc -p tsconfig.bun.json --noEmit && tsc -p tsconfig.vite.json --noEmit",
    "dev": "vite build && electrobun dev --watch",
    "dev:hmr": "bun run build:native && concurrently \"bun run hmr\" \"bun run start\"",
    "dev:windows": "bun run build:native:windows-helper && vite build && electrobun dev --watch",
    "hmr": "vite --port 5173",
    "build:all": "bun run build:stable && bun run build:canary",
    "release": "bash scripts/release.sh",
    "release:canary": "bash scripts/release.sh canary",
    "release:stable": "bash scripts/release.sh stable",
    "release:bridge-migration": "bash scripts/release-bridge-migration.sh",
    "release:local": "bash scripts/release.sh --local",
    "build:stable": "bun run build:native && vite build && CODICTATE_CHANNEL=stable electrobun build --env=stable",
    "build:canary": "bun run build:native && vite build && CODICTATE_CHANNEL=canary electrobun build --env=canary",
    "build:installer:windows": "powershell -ExecutionPolicy Bypass -File scripts/build-inno-installer.ps1",
    "build:native": "src/scripts/build-swift.sh",
    "build:native:windows-helper": "cargo build --release --manifest-path native/CodictateWindowsHelper/Cargo.toml",
    "check:native:windows-helper": "cargo fmt --check --manifest-path native/CodictateWindowsHelper/Cargo.toml && cargo check --manifest-path native/CodictateWindowsHelper/Cargo.toml && cargo clippy --manifest-path native/CodictateWindowsHelper/Cargo.toml -- -D warnings && cargo test --manifest-path native/CodictateWindowsHelper/Cargo.toml",
    "start": "bun run build:native && vite build && CODICTATE_CHANNEL=dev electrobun dev",
    "start:windows": "bun run build:native:windows-helper && vite build && CODICTATE_CHANNEL=dev electrobun dev",
    "postbuild": "chmod +x build/dev-macos-arm64/react-tailwind-vite-dev.app/Contents/Resources/native-helpers/KeyListener build/dev-macos-arm64/react-tailwind-vite-dev.app/Contents/Resources/native-helpers/MicRecorder",
    "bench:stt": "bun run benchmarks/run-stt.ts",
    "bench:charts:check": "python3 benchmarks/stt/charts.py --self-check",
    "benchmark": "bun run benchmarks/run-stt.ts"
  },
  "dependencies": {
    "@fontsource/iceberg": "^5.2.8",
    "@fontsource/iceland": "^5.2.8",
    "@huggingface/hub": "2.11.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "5.101.4",
    "clsx": "^2.1.1",
    "electrobun": "1.18.1",
    "motion": "13.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bun": "1.3.14",
    "@types/three": "0.185.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "^10.5.4",
    "bun-types": "1.3.14",
    "concurrently": "10.0.",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  }
}
